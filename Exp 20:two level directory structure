#include <stdio.h>
#include <string.h>

#define MAX_USERS 10
#define MAX_FILES 10

struct file {
    char fname[20];
};

struct user {
    char uname[20];
    struct file files[MAX_FILES];
    int fcount;
};

int main() {
    struct user users[MAX_USERS];
    int ucount = 0;
    int choice;
    char uname[20], fname[20];

    while (1) {
        printf("\n--- Two Level Directory Structure ---\n");
        printf("1. Create User\n");
        printf("2. Create File\n");
        printf("3. Display Files of User\n");
        printf("4. Search File\n");
        printf("5. Delete File\n");
        printf("6. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {

        case 1: // Create User
            printf("Enter user name: ");
            scanf("%s", uname);

            int exists = 0;
            for (int i = 0; i < ucount; i++) {
                if (strcmp(users[i].uname, uname) == 0) {
                    exists = 1;
                    break;
                }
            }

            if (exists)
                printf("User already exists!\n");
            else {
                strcpy(users[ucount].uname, uname);
                users[ucount].fcount = 0;
                ucount++;
                printf("User created successfully.\n");
            }
            break;

        case 2: // Create File
            printf("Enter user name: ");
            scanf("%s", uname);

            int uindex = -1;
            for (int i = 0; i < ucount; i++) {
                if (strcmp(users[i].uname, uname) == 0) {
                    uindex = i;
                    break;
                }
            }

            if (uindex == -1) {
                printf("User not found!\n");
                break;
            }

            printf("Enter file name: ");
            scanf("%s", fname);

            int fexists = 0;
            for (int i = 0; i < users[uindex].fcount; i++) {
                if (strcmp(users[uindex].files[i].fname, fname) == 0) {
                    fexists = 1;
                    break;
                }
            }

            if (fexists)
                printf("File already exists for this user!\n");
            else {
                strcpy(users[uindex].files[users[uindex].fcount].fname, fname);
                users[uindex].fcount++;
                printf("File created successfully.\n");
            }
            break;

        case 3: // Display Files
            printf("Enter user name: ");
            scanf("%s", uname);

            uindex = -1;
            for (int i = 0; i < ucount; i++) {
                if (strcmp(users[i].uname, uname) == 0) {
                    uindex = i;
                    break;
                }
            }

            if (uindex == -1)
                printf("User not found!\n");
            else {
                if (users[uindex].fcount == 0)
                    printf("No files for this user.\n");
                else {
                    printf("Files of user %s:\n", uname);
                    for (int i = 0; i < users[uindex].fcount; i++)
                        printf("%s\n", users[uindex].files[i].fname);
                }
            }
            break;

        case 4: // Search File
            printf("Enter user name: ");
            scanf("%s", uname);
            printf("Enter file name: ");
            scanf("%s", fname);

            uindex = -1;
            for (int i = 0; i < ucount; i++) {
                if (strcmp(users[i].uname, uname) == 0) {
                    uindex = i;
                    break;
                }
            }

            if (uindex == -1) {
                printf("User not found!\n");
                break;
            }

            fexists = 0;
            for (int i = 0; i < users[uindex].fcount; i++) {
                if (strcmp(users[uindex].files[i].fname, fname) == 0) {
                    fexists = 1;
                    break;
                }
            }

            if (fexists)
                printf("File found.\n");
            else
                printf("File not found.\n");
            break;

        case 5: // Delete File
            printf("Enter user name: ");
            scanf("%s", uname);
            printf("Enter file name: ");
            scanf("%s", fname);

            uindex = -1;
            for (int i = 0; i < ucount; i++) {
                if (strcmp(users[i].uname, uname) == 0) {
                    uindex = i;
                    break;
                }
            }

            if (uindex == -1) {
                printf("User not found!\n");
                break;
            }

            int findex = -1;
            for (int i = 0; i < users[uindex].fcount; i++) {
                if (strcmp(users[uindex].files[i].fname, fname) == 0) {
                    findex = i;
                    break;
                }
            }

            if (findex == -1)
                printf("File not found!\n");
            else {
                for (int i = findex; i < users[uindex].fcount - 1; i++)
                    users[uindex].files[i] = users[uindex].files[i + 1];

                users[uindex].fcount--;
                printf("File deleted successfully.\n");
            }
            break;

        case 6:
            return 0;

        default:
            printf("Invalid choice!\n");
        }
    }
}
