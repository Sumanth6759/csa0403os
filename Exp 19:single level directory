#include <stdio.h>
#include <string.h>

struct file {
    char fname[20];
};

int main() {
    struct file dir[50];
    int n = 0, choice;
    char name[20];

    while (1) {
        printf("\n--- Single Level Directory ---\n");
        printf("1. Create File\n");
        printf("2. Display Files\n");
        printf("3. Search File\n");
        printf("4. Delete File\n");
        printf("5. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {

        case 1: // Create
            printf("Enter file name: ");
            scanf("%s", name);

            int exists = 0;
            for (int i = 0; i < n; i++) {
                if (strcmp(dir[i].fname, name) == 0) {
                    exists = 1;
                    break;
                }
            }

            if (exists)
                printf("File already exists!\n");
            else {
                strcpy(dir[n].fname, name);
                n++;
                printf("File created successfully.\n");
            }
            break;

        case 2: // Display
            if (n == 0)
                printf("Directory is empty.\n");
            else {
                printf("Files in directory:\n");
                for (int i = 0; i < n; i++)
                    printf("%s\n", dir[i].fname);
            }
            break;

        case 3: // Search
            printf("Enter file name to search: ");
            scanf("%s", name);

            int found = 0;
            for (int i = 0; i < n; i++) {
                if (strcmp(dir[i].fname, name) == 0) {
                    found = 1;
                    break;
                }
            }

            if (found)
                printf("File found.\n");
            else
                printf("File not found.\n");
            break;

        case 4: // Delete
            printf("Enter file name to delete: ");
            scanf("%s", name);

            int index = -1;
            for (int i = 0; i < n; i++) {
                if (strcmp(dir[i].fname, name) == 0) {
                    index = i;
                    break;
                }
            }

            if (index == -1)
                printf("File not found.\n");
            else {
                for (int i = index; i < n - 1; i++) {
                    dir[i] = dir[i + 1];
                }
                n--;
                printf("File deleted successfully.\n");
            }
            break;

        case 5:
            return 0;

        default:
            printf("Invalid choice!\n");
        }
    }
}
