#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>

sem_t mutex, writeblock;
int data = 0, readcount = 0;

void *reader(void *arg) {
    sem_wait(&mutex);
    readcount++;
    if (readcount == 1)
        sem_wait(&writeblock);
    sem_post(&mutex);

    printf("Reader reads data = %d\n", data);
    sleep(1);

    sem_wait(&mutex);
    readcount--;
    if (readcount == 0)
        sem_post(&writeblock);
    sem_post(&mutex);
    return NULL;
}

void *writer(void *arg) {
    sem_wait(&writeblock);
    data++;
    printf("Writer writes data = %d\n", data);
    sleep(1);
    sem_post(&writeblock);
    return NULL;
}

int main() {
    pthread_t r[3], w[2];
    sem_init(&mutex, 0, 1);
    sem_init(&writeblock, 0, 1);

    for (int i = 0; i < 3; i++)
        pthread_create(&r[i], NULL, reader, NULL);
    for (int i = 0; i < 2; i++)
        pthread_create(&w[i], NULL, writer, NULL);

    for (int i = 0; i < 3; i++)
        pthread_join(r[i], NULL);
    for (int i = 0; i < 2; i++)
        pthread_join(w[i], NULL);

    return 0;
}
