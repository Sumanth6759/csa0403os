#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>

#define N 5

sem_t forks[N];

void* philosopher(void* num) {
    int id = *(int*)num;

    printf("Philosopher %d is thinking\n", id);
    sleep(1);

    // Pick forks (avoid deadlock by order)
    sem_wait(&forks[id]);
    sem_wait(&forks[(id + 1) % N]);

    printf("Philosopher %d is eating\n", id);
    sleep(1);

    // Put forks
    sem_post(&forks[id]);
    sem_post(&forks[(id + 1) % N]);

    printf("Philosopher %d finished eating\n", id);

    return NULL;
}

int main() {
    pthread_t phil[N];
    int i, ids[N];

    // Initialize semaphores
    for (i = 0; i < N; i++)
        sem_init(&forks[i], 0, 1);

    // Create philosopher threads
    for (i = 0; i < N; i++) {
        ids[i] = i;
        pthread_create(&phil[i], NULL, philosopher, &ids[i]);
    }

    // Join threads
    for (i = 0; i < N; i++)
        pthread_join(phil[i], NULL);

    // Destroy semaphores
    for (i = 0; i < N; i++)
        sem_destroy(&forks[i]);

    return 0;
}
