#include <stdio.h>

int main() {
    int frames, pages, i, j, k, faults = 0, time = 0;
    int frame[10], page[20], recent[10];

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    printf("Enter number of pages: ");
    scanf("%d", &pages);

    printf("Enter page reference string:\n");
    for (i = 0; i < pages; i++)
        scanf("%d", &page[i]);

    for (i = 0; i < frames; i++) {
        frame[i] = -1;
        recent[i] = 0;
    }

    printf("\nPage\tFrames\n");

    for (i = 0; i < pages; i++) {
        int found = 0;

        for (j = 0; j < frames; j++) {
            if (frame[j] == page[i]) {
                found = 1;
                recent[j] = ++time;
                break;
            }
        }

        if (!found) {
            int lru = 0;
            for (j = 1; j < frames; j++) {
                if (recent[j] < recent[lru])
                    lru = j;
            }
            frame[lru] = page[i];
            recent[lru] = ++time;
            faults++;
        }

        printf("%d\t", page[i]);
        for (j = 0; j < frames; j++) {
            if (frame[j] != -1)
                printf("%d ", frame[j]);
            else
                printf("- ");
        }
        printf("\n");
    }

    printf("\nTotal Page Faults = %d\n", faults);

    return 0;
}
