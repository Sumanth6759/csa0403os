#include <stdio.h>
#include <pthread.h>

// Thread function
void* thread_function(void* arg) {
    int id = *(int*)arg;
    printf("Hello from Thread %d\n", id);
    return NULL;
}

int main() {
    pthread_t threads[3];
    int ids[3];
    int i;

    // Create threads
    for (i = 0; i < 3; i++) {
        ids[i] = i + 1;
        pthread_create(&threads[i], NULL, thread_function, &ids[i]);
    }

    // Join threads
    for (i = 0; i < 3; i++) {
        pthread_join(threads[i], NULL);
    }

    printf("All threads completed execution\n");

    return 0;
}
