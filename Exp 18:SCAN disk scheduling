#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, head, disk_size, direction;
    int totalSeek = 0;

    printf("Enter number of disk requests: ");
    scanf("%d", &n);

    int request[n + 1];

    printf("Enter the disk request sequence:\n");
    for (int i = 0; i < n; i++) {
        scanf("%d", &request[i]);
    }

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size (total number of cylinders): ");
    scanf("%d", &disk_size);

    printf("Enter direction (0 = left, 1 = right): ");
    scanf("%d", &direction);

    // Add head position to request array
    request[n] = head;
    n++;

    // Sort requests
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (request[j] > request[j + 1]) {
                int temp = request[j];
                request[j] = request[j + 1];
                request[j + 1] = temp;
            }
        }
    }

    int pos;
    for (int i = 0; i < n; i++) {
        if (request[i] == head) {
            pos = i;
            break;
        }
    }

    printf("\nDisk movement:\n");

    // Move right
    if (direction == 1) {
        for (int i = pos; i < n - 1; i++) {
            printf("%d -> %d\n", request[i], request[i + 1]);
            totalSeek += abs(request[i + 1] - request[i]);
        }

        // Move to end
        totalSeek += abs((disk_size - 1) - request[n - 1]);
        printf("%d -> %d\n", request[n - 1], disk_size - 1);

        // Reverse direction
        for (int i = pos - 1; i >= 0; i--) {
            printf("%d -> %d\n", disk_size - 1, request[i]);
            totalSeek += abs((disk_size - 1) - request[i]);
        }
    }
    // Move left
    else {
        for (int i = pos; i > 0; i--) {
            printf("%d -> %d\n", request[i], request[i - 1]);
            totalSeek += abs(request[i] - request[i - 1]);
        }

        // Move to start
        totalSeek += abs(request[0] - 0);
        printf("%d -> %d\n", request[0], 0);

        // Reverse direction
        for (int i = pos + 1; i < n; i++) {
            printf("%d -> %d\n", 0, request[i]);
            totalSeek += abs(request[i] - 0);
        }
    }

    printf("\nTotal Seek Time = %d\n", totalSeek);
    printf("Average Seek Time = %.2f\n", (float)totalSeek / (n - 1));

    return 0;
}
