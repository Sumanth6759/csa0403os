#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main() {
    int fd;
    struct stat fileStat;
    DIR *dir;
    struct dirent *entry;

    /* ---------- fcntl() ---------- */
    fd = open("sample.txt", O_CREAT | O_RDWR, 0644);
    if (fd < 0) {
        perror("open");
        return 1;
    }

    int flags = fcntl(fd, F_GETFL);
    printf("File access mode using fcntl: ");
    if ((flags & O_ACCMODE) == O_RDONLY)
        printf("Read Only\n");
    else if ((flags & O_ACCMODE) == O_WRONLY)
        printf("Write Only\n");
    else
        printf("Read & Write\n");

    /* ---------- lseek() ---------- */
    write(fd, "Hello UNIX", 10);
    lseek(fd, 0, SEEK_SET);   // Move file pointer to beginning

    char buffer[20];
    read(fd, buffer, 10);
    buffer[10] = '\0';
    printf("Data read using lseek: %s\n", buffer);

    close(fd);

    /* ---------- stat() ---------- */
    stat("sample.txt", &fileStat);
    printf("\nFile Information using stat():\n");
    printf("File size: %ld bytes\n", fileStat.st_size);
    printf("Inode number: %ld\n", fileStat.st_ino);
    printf("Permissions: %o\n", fileStat.st_mode & 0777);

    /* ---------- opendir() & readdir() ---------- */
    dir = opendir(".");
    if (dir == NULL) {
        perror("opendir");
        return 1;
    }

    printf("\nFiles in current directory:\n");
    while ((entry = readdir(dir)) != NULL) {
        printf("%s\n", entry->d_name);
    }

    closedir(dir);

    return 0;
}
