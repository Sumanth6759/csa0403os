#include <stdio.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/types.h>
#include <unistd.h>
#include <string.h>

int main() {
    int shmid;
    char *shared_mem;
    key_t key = 1234;

    // Create shared memory segment
    shmid = shmget(key, 1024, IPC_CREAT | 0666);
    if (shmid < 0) {
        perror("shmget failed");
        return 1;
    }

    // Attach shared memory
    shared_mem = (char *) shmat(shmid, NULL, 0);

    if (fork() == 0) {
        // Child process
        sleep(1);  // Ensure parent writes first
        printf("Child Process Reads: %s\n", shared_mem);
        shmdt(shared_mem);
    } else {
        // Parent process
        strcpy(shared_mem, "Hello from Parent using Shared Memory");
        printf("Parent Process Writes: %s\n", shared_mem);
        wait(NULL);
        shmdt(shared_mem);
        shmctl(shmid, IPC_RMID, NULL); // Remove shared memory
    }

    return 0;
}
