#include <stdio.h>
#include <limits.h>

int main() {
    int n, i, time = 0, completed = 0;
    int at[10], bt[10], rt[10], pr[10];
    int ct[10], tat[10], wt[10];
    int smallest;
    float avg_wt = 0, avg_tat = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter Arrival Time, Burst Time and Priority\n");
    printf("(Lower priority number means higher priority)\n");

    for (i = 0; i < n; i++) {
        printf("Process %d:\n", i + 1);
        printf("Arrival Time: ");
        scanf("%d", &at[i]);
        printf("Burst Time: ");
        scanf("%d", &bt[i]);
        printf("Priority: ");
        scanf("%d", &pr[i]);
        rt[i] = bt[i]; // Remaining time
    }

    while (completed != n) {
        smallest = -1;
        int highest_priority = INT_MAX;

        // Select process with highest priority among arrived processes
        for (i = 0; i < n; i++) {
            if (at[i] <= time && rt[i] > 0 && pr[i] < highest_priority) {
                highest_priority = pr[i];
                smallest = i;
            }
        }

        if (smallest == -1) {
            time++; // CPU idle
        } else {
            rt[smallest]--; // Execute for 1 unit
            time++;

            if (rt[smallest] == 0) {
                completed++;
                ct[smallest] = time;
                tat[smallest] = ct[smallest] - at[smallest];
                wt[smallest] = tat[smallest] - bt[smallest];

                avg_wt += wt[smallest];
                avg_tat += tat[smallest];
            }
        }
    }

    avg_wt /= n;
    avg_tat /= n;

    // Display results
    printf("\nProcess AT BT Priority CT TAT WT\n");
    for (i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\t%d\t%d\n",
               i + 1, at[i], bt[i], pr[i], ct[i], tat[i], wt[i]);
    }

    printf("\nAverage Waiting Time = %.2f", avg_wt);
    printf("\nAverage Turnaround Time = %.2f\n", avg_tat);

    return 0;
}
