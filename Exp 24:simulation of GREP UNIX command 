#include <stdio.h>
#include <string.h>

int main() {
    char filename[50], line[256], pattern[50];
    FILE *fp;

    // Get file name
    printf("Enter file name: ");
    scanf("%s", filename);

    // Open file
    fp = fopen(filename, "r");
    if (fp == NULL) {
        perror("fopen");
        return 1;
    }

    // Get search pattern
    printf("Enter search pattern: ");
    scanf("%s", pattern);

    printf("\nLines containing '%s':\n", pattern);

    // Read file line by line
    while (fgets(line, sizeof(line), fp) != NULL) {
        if (strstr(line, pattern) != NULL) {
            printf("%s", line);  // print line if pattern found
        }
    }

    fclose(fp);
    return 0;
}
