#include <stdio.h>

int main() {
    int frames, pages, i, j, k, faults = 0;
    int frame[10], page[20];

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    printf("Enter number of pages: ");
    scanf("%d", &pages);

    printf("Enter page reference string:\n");
    for (i = 0; i < pages; i++)
        scanf("%d", &page[i]);

    for (i = 0; i < frames; i++)
        frame[i] = -1;

    printf("\nPage\tFrames\n");

    for (i = 0; i < pages; i++) {
        int found = 0;

        for (j = 0; j < frames; j++) {
            if (frame[j] == page[i]) {
                found = 1;
                break;
            }
        }

        if (!found) {
            int idx = -1, farthest = i + 1;

            for (j = 0; j < frames; j++) {
                for (k = i + 1; k < pages; k++) {
                    if (frame[j] == page[k])
                        break;
                }

                if (k == pages) {
                    idx = j;
                    break;
                }

                if (k > farthest) {
                    farthest = k;
                    idx = j;
                }
            }

            if (idx == -1)
                idx = 0;

            frame[idx] = page[i];
            faults++;
        }

        printf("%d\t", page[i]);
        for (j = 0; j < frames; j++) {
            if (frame[j] != -1)
                printf("%d ", frame[j]);
            else
                printf("- ");
        }
        printf("\n");
    }

    printf("\nTotal Page Faults = %d\n", faults);

    return 0;
}
