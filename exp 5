#include <stdio.h>

int main() {
    int n;
    int at[10], bt[10], pr[10], ct[10], tat[10], wt[10];
    int completed = 0, time = 0, i;
    int min_pr, idx;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Enter Arrival Time, Burst Time, Priority for P%d: ", i + 1);
        scanf("%d %d %d", &at[i], &bt[i], &pr[i]);
    }

    while (completed < n) {
        min_pr = 9999;
        idx = -1;

        for (i = 0; i < n; i++) {
            if (at[i] <= time && bt[i] > 0 && pr[i] < min_pr) {
                min_pr = pr[i];
                idx = i;
            }
        }

        if (idx != -1) {
            time += bt[idx];
            ct[idx] = time;
            bt[idx] = 0;
            completed++;
        } else {
            time++;
        }
    }

    printf("\nProcess\tAT\tBT\tPR\tCT\tTAT\tWT\n");
    for (i = 0; i < n; i++) {
        tat[i] = ct[i] - at[i];
        wt[i] = tat[i]; // bt already consumed
        printf("P%d\t%d\t%d\t%d\t%d\t%d\t%d\n",
               i + 1, at[i], 0, pr[i], ct[i], tat[i], wt[i]);
    }

    return 0;
}
