#include <stdio.h>
#include <sys/stat.h>
#include <unistd.h>
#include <pwd.h>
#include <grp.h>

int main() {
    char filename[50];
    struct stat fileStat;

    printf("Enter file name: ");
    scanf("%s", filename);

    if(stat(filename, &fileStat) < 0) {
        perror("stat");
        return 1;
    }

    // File type
    printf("\nFile: %s\n", filename);
    printf("File type: ");
    if(S_ISREG(fileStat.st_mode)) printf("Regular File\n");
    else if(S_ISDIR(fileStat.st_mode)) printf("Directory\n");
    else if(S_ISLNK(fileStat.st_mode)) printf("Symbolic Link\n");
    else printf("Other\n");

    // Permissions
    printf("Permissions:\n");
    printf("User: %c%c%c\n",
        (fileStat.st_mode & S_IRUSR) ? 'r' : '-',
        (fileStat.st_mode & S_IWUSR) ? 'w' : '-',
        (fileStat.st_mode & S_IXUSR) ? 'x' : '-');

    printf("Group: %c%c%c\n",
        (fileStat.st_mode & S_IRGRP) ? 'r' : '-',
        (fileStat.st_mode & S_IWGRP) ? 'w' : '-',
        (fileStat.st_mode & S_IXGRP) ? 'x' : '-');

    printf("Others: %c%c%c\n",
        (fileStat.st_mode & S_IROTH) ? 'r' : '-',
        (fileStat.st_mode & S_IWOTH) ? 'w' : '-',
        (fileStat.st_mode & S_IXOTH) ? 'x' : '-');

    // Owner and Group
    struct passwd *pw = getpwuid(fileStat.st_uid);
    struct group  *gr = getgrgid(fileStat.st_gid);

    printf("Owner: %s\n", pw->pw_name);
    printf("Group: %s\n", gr->gr_name);

    return 0;
}
